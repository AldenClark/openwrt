# AirRelay OS for Nokia XG-040G-MF (AN7583), UBI layout only.
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7583=y
CONFIG_TARGET_MULTI_PROFILE=y
# CONFIG_TARGET_ALL_PROFILES is not set
CONFIG_TARGET_DEVICE_airoha_an7583_DEVICE_nokia_xg-040g-mf-ubi=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_DEVICE_PACKAGES_airoha_an7583_DEVICE_nokia_xg-040g-mf-ubi="-kmod-usb-ledtrig-usbport"

# Kernel WireGuard: included in the image, not a userspace tunnel engine.
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y

# Minimal IPv4 exit-node forwarding and NAT.
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nf-conntrack=y

# Temporary LuCI status/configuration UI, without unused PPP/package pages.
CONFIG_PACKAGE_luci-mod-admin-full=y
# CONFIG_PACKAGE_luci-theme-bootstrap is not set
CONFIG_PACKAGE_luci-theme-airrelay=y
CONFIG_LUCI_LANG_zh_Hans=y
# LuCI does not include the WireGuard protocol editor in admin-full.
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_px5g-mbedtls=y
CONFIG_PACKAGE_libustream-mbedtls=y
CONFIG_PACKAGE_dropbear=y

# Keep the BusyBox DHCP/NTP clients; omit unused server and cron applets.
# OpenWrt otherwise enables kernel DWARF debug info by default on normal flash.
# CONFIG_KERNEL_DEBUG_INFO is not set
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_UDHCPC=y
CONFIG_BUSYBOX_CONFIG_NTPD=y
# CONFIG_BUSYBOX_CONFIG_UDHCPD is not set
# CONFIG_BUSYBOX_CONFIG_DHCPRELAY is not set
# CONFIG_BUSYBOX_CONFIG_CROND is not set
# CONFIG_BUSYBOX_CONFIG_CRONTAB is not set
# CONFIG_BUSYBOX_CONFIG_FEATURE_NTPD_SERVER is not set

# Keep the essential UBI/recovery and management packages.
CONFIG_PACKAGE_fitblk=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_ca-bundle=y

# No DHCP server, PPPoE, IPv6 DHCP services, IPsec, or proxy dataplane.
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_dnsmasq-full is not set
# CONFIG_PACKAGE_odhcp6c is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set
# CONFIG_PACKAGE_kmod-nft-offload is not set
# CONFIG_PACKAGE_kmod-tun is not set
# CONFIG_PACKAGE_kmod-nft-tproxy is not set
# CONFIG_PACKAGE_strongswan is not set
# CONFIG_PACKAGE_kmod-ipt-ipsec is not set
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-ledtrig-usbport is not set

# AirRelay OS branding (also controls /etc/openwrt_release and image prefix).
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="AirRelay OS"
CONFIG_VERSION_NUMBER="0.1.0-dev"
CONFIG_VERSION_MANUFACTURER="AirRelay"
CONFIG_VERSION_PRODUCT="AirRelay Edge Node"
CONFIG_VERSION_HOME_URL="https://github.com/AldenClark/openwrt"
CONFIG_VERSION_FIRMWARE_URL="https://github.com/AldenClark/openwrt/releases"
# CONFIG_VERSION_FILENAMES is not set
# CONFIG_VERSION_CODE_FILENAMES is not set

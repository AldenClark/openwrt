#!/bin/sh
# Run only on the two supported Nokia boards, after OpenWrt generated br-lan.
. /lib/functions/system.sh

case "$(board_name)" in
	nokia,xg-040g-md|nokia,xg-040g-md-ubi|\
	nokia,xg-040g-mf|nokia,xg-040g-mf-ubi)
		;;
	*)
		exit 0
		;;
esac

# Keep the stock board's lan1..lan4 bridge but obtain its management IP via DHCP.
# Deliberately do not offer DHCP to the upstream LAN.
uci -q get network.lan >/dev/null || exit 1
uci set network.lan.proto='dhcp' || exit 1
uci -q delete network.lan.ipaddr
uci -q delete network.lan.netmask
uci -q delete network.lan.gateway
uci -q delete network.lan.dns
uci -q delete network.lan.ip6assign
uci -q delete network.wan
uci -q delete network.wan6
uci commit network || exit 1

if uci -q get dhcp.lan >/dev/null; then
	uci set dhcp.lan.ignore='1'
	uci commit dhcp
fi

exit 0

{
  "admin/airrelay": {
    "title": "AirRelay",
    "order": 1,
    "action": {
      "type": "firstchild",
      "preferred": "overview",
      "recurse": true
    },
    "depends": {
      "acl": [
        "luci-theme-airrelay"
      ]
    }
  },
  "admin/airrelay/overview": {
    "title": "Live status",
    "order": 1,
    "action": {
      "type": "view",
      "path": "airrelay/overview"
    },
    "depends": {
      "acl": [
        "luci-theme-airrelay"
      ]
    }
  },
  "admin/airrelay/agent": {
    "title": "AirRoute Agent",
    "order": 4,
    "action": {
      "type": "view",
      "path": "airrelay/agent"
    },
    "depends": {
      "acl": [
        "luci-theme-airrelay"
      ],
      "fs": {
        "/etc/init.d/airroute-agent": "executable"
      }
    }
  },
  "admin/airrelay/settings": {
    "title": "Settings",
    "order": 2,
    "action": {
      "type": "view",
      "path": "airrelay/settings"
    },
    "depends": {
      "acl": [
        "luci-mod-network-config",
        "luci-mod-system-flash",
        "luci-proto-wireguard"
      ]
    }
  },
  "admin/airrelay/network": {
    "action": {
      "type": "alias",
      "path": "admin/airrelay/settings"
    }
  },
  "admin/airrelay/upgrade": {
    "action": {
      "type": "alias",
      "path": "admin/airrelay/settings"
    }
  }
}
